# Database connection strings (PostgreSQL)
# DATABASE_URL: Pooled connection string (e.g., Supabase / PgBouncer / Neon pooled port 6543)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct connection string for Prisma migrations (port 5432)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
# SHADOW_DATABASE_URL: Optional shadow database for prisma migrate dev on cloud providers
SHADOW_DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/shadow_db"

# Authentication
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-or-base64-secret"
SEED_ADMIN_EMAIL="admin@chargeshare.pk"
SEED_ADMIN_PASSWORD="AdminPassword123!"

# Object Storage (S3 / Cloudflare R2 / Supabase Storage placeholders)
STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
STORAGE_BUCKET="chargeshare-media"
STORAGE_ACCESS_KEY_ID="your-storage-access-key-id"
STORAGE_SECRET_ACCESS_KEY="your-storage-secret-access-key"
STORAGE_PUBLIC_URL="https://media.chargeshare.pk"

# Server & App Config
PORT=3000
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Test Database (Used exclusively by automated tests, never use dev DB)
TEST_DATABASE_URL="postgresql://postgres:[PASSWORD]@localhost:5432/chargeshare_test"

# Google Auth
GOOGLE_CLIENT_IDS="your-web-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com"

# Email Delivery (Resend - falls back to console logging in development if omitted)
RESEND_API_KEY="re_123456789"
RESEND_FROM_EMAIL="ChargeShare <noreply@chargeshare.pk>"

# Rate Limiting (Upstash Redis - bypassed with warning in dev if omitted)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Background Cron Security
CRON_SECRET="replace-with-a-secure-random-token"
