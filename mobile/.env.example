# ChargeShare Mobile Environment Variables

# API Base URL (must end with /api/v1)
# - Android Emulator: http://10.0.2.2:3000/api/v1
# - Physical Android device over LAN: http://<YOUR_COMPUTER_LAN_IP>:3000/api/v1
# - Production / Preview: https://<your-deployed-domain>.vercel.app/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1

# Google OAuth Web Client ID (from Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs -> Web client)
# Note: Google Sign-In requires an EAS Development Build or native prebuild (not standard Expo Go).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# LOCAL DEVELOPMENT & CLEARTEXT TRAFFIC:
# Android blocks plain HTTP (cleartext) traffic by default.
# For local dev builds with an emulator (10.0.2.2) or LAN IP (192.168.x.x),
# Android usesCleartextTraffic is enabled in the development build manifest.
# Production builds must ALWAYS communicate over secure HTTPS (e.g. Vercel).
# -----------------------------------------------------------------------------
